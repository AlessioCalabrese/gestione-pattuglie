# ==========================================
# BACKEND (Java / Spring Boot / Maven)
# ==========================================
# Output di build
target/
build/
out/
bin/
.gradle/

# Artefatti compilati (il wrapper Maven, se presente, va invece versionato)
*.jar
*.war
*.ear
*.class
!.mvn/wrapper/maven-wrapper.jar

# Log e file temporanei
*.log
logs/
tmp/
.tmp/

# Crash dump JVM
hs_err_pid*
replay_pid*

# ==========================================
# FRONTEND (Angular / Node)
# ==========================================
# Dipendenze
node_modules/

# Node/npm scaricati da frontend-maven-plugin in fase di build (~80 MB, con node.exe)
frontend/node/

# Output di build Angular e cache (qualunque sia la cartella di destinazione)
dist/
.angular/
frontend/dist/

# Build Angular copiata tra le risorse di Spring Boot: viene rigenerata da "npm run build"
src/main/resources/static/

# Log e cache di npm/yarn/pnpm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/
.eslintcache

# Copertura test
coverage/
*.lcov

# ==========================================
# IDE / EDITOR
# ==========================================
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# Eclipse / STS
.metadata/
.classpath
.project
.settings/
.factorypath
*.launch

# NetBeans
nbproject/
nbbuild/

# Visual Studio Code
.vscode/*
!.vscode/extensions.json

# ==========================================
# SISTEMA OPERATIVO
# ==========================================
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp

# ==========================================
# SICUREZZA & DATI SENSIBILI
# ==========================================
# Variabili d'ambiente e override locali (non committare mai credenziali reali)
.env
.env.*
!.env.example
application-local.properties
application-*-local.properties
application-secret*.properties

# Chiavi e certificati
*.pem
*.key
*.jks
*.p12
*.pfx
*.keystore

# ==========================================
# DATI LOCALI
# ==========================================
# Dump e backup del database
*.bak
*.mdf
*.ldf
*.dump
/frontend/package-lock.json
